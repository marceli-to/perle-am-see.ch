{
  "require": {
    "craftcms/cms": "4.17.15",
    "craftcms/feed-me": "5.14.0",
    "craftcms/redactor": "^3.1.0",
    "craftcms/security-patches": "dev-main",
    "fortrabbit/craft-object-storage": "^3.0.0",
    "nystudio107/craft-vite": "^4.0.10",
    "sebastianlenz/linkfield": "^2.1.5",
    "solspace/craft-freeform": "4.1.26",
    "verbb/expanded-singles": "2.0.6",
    "vlucas/phpdotenv": "^5.4.0"
  },
  "conflict": {
    "solspace/craft-freeform": "^5.0.0"
  },
  "autoload": {
    "psr-4": {
      "modules\\": "modules/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  },
  "scripts": {
    "pre-craft-update": [
      "@php craft db/backup --interactive=0 || exit 0"
    ],
    "post-craft-update": [
      "Composer\\Config::disableProcessTimeout",
      "@php craft install/check && php craft clear-caches/all --interactive=0 || exit 0",
      "@php craft install/check && php craft migrate/all --interactive=0 || exit 0",
      "@php craft install/check && php craft project-config/apply --interactive=0 || exit 0"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "pre-update-cmd": "@pre-craft-update",
    "post-update-cmd": "@post-craft-update",
    "pre-install-cmd": "@pre-craft-update",
    "post-install-cmd": "@post-craft-update"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    }
  ]
}
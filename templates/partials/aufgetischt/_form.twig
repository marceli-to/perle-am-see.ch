{% set form = craft.freeform.form(formHandle, {
	class: 'row',
	dynamicNotification: { recipients: entry.eMailAdresseFuerAnmeldungen, template: "anmeldungAufgetischt.twig" },
	overrideValues: { aktivitaet: entry.title },
    submitClass: "btn btn-red text-uppercase",
    returnUrl: siteUrl ~ "verein/aufgetischt?success=1",
    submissionToken: submissionToken|default(null),
}) %}


{% if entry.anmeldefrist < now %}
<div class="row">
    <div class="col-12">
		Vielen Dank für Ihr Interesse.<br>Die Anmeldefrist für diesen Anlass ist bereits vorbei..
    </div>
</div>


{% else %}

{% include "partials/_form_anmeldung.twig" %}

{% endif %}